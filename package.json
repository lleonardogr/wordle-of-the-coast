{
  "name": "wordle-of-the-coast",
  "version": "1.0.0",
  "private": true,
  "description": "Wordle of the Coast — adivinhe a criatura lendária de Magic: The Gathering do dia usando dados da API do Scryfall.",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "fetch-cards": "node scripts/fetch-cards.mjs",
    "serve": "python3 -m http.server 8123",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "lint:commits": "node scripts/lint-commit-msg.mjs --range origin/main..HEAD"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lleonardogr/wordle-of-the-coast.git"
  },
  "homepage": "https://lleonardogr.github.io/wordle-of-the-coast/",
  "bugs": {
    "url": "https://github.com/lleonardogr/wordle-of-the-coast/issues"
  }
}
