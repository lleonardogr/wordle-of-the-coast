{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "wordle-of-the-coast",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["index.html"],
      "changelog-sections": [
        { "type": "feat", "section": "Novidades" },
        { "type": "fix", "section": "Correções" },
        { "type": "perf", "section": "Desempenho" },
        { "type": "revert", "section": "Reversões" },
        { "type": "refactor", "section": "Refatoração", "hidden": true },
        { "type": "docs", "section": "Documentação", "hidden": true },
        { "type": "style", "section": "Estilo", "hidden": true },
        { "type": "test", "section": "Testes", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Manutenção", "hidden": true }
      ]
    }
  }
}
